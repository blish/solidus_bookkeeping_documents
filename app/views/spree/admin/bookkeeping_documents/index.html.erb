<% if order_focused? %>
  <%= render partial: 'spree/admin/shared/order_tabs', locals: { current: :documents } %>

  <% content_for :page_title do %>
    <%= t(:documents_for_order, scope: [:spree, :print_invoice], order_number: @order.number) %>
  <% end %>
<% else %>
  <% content_for :page_title do %>
    <%= t(@document_type, scope: [:spree, :print_invoice, :document_headlines]) %>
  <% end %>

  <% content_for :table_filter_title do %>
    <%= Spree.t(:search) %>
  <% end %>

  <% content_for :table_filter do %>
    <div data-hook="admin_orders_index_search">
      <%= search_form_for [:admin, @search] do |f| %>
        <%= f.hidden_field :template_cont, value: params[:q][:template_cont] %>
        <div class="row">
          <div class="five columns alpha">
            <div class="date-range-filter field">
              <%= f.label :created_at_gt,
                Spree::BookkeepingDocument.human_attribute_name(:created_at) %>
              <div class="date-range-fields">
                <%= f.text_field :created_at_gt,
                  value: params[:q][:created_at_gt],
                  class: 'datepicker datepicker-from',
                  placeholder: Spree.t(:start) %>
                <span class="range-divider">
                  <i class="fa fa-arrow-right"></i>
                </span>
                <%= f.text_field :created_at_lt,
                  value: params[:q][:created_at_lt],
                  class: 'datepicker datepicker-to',
                  placeholder: Spree.t(:stop) %>
              </div>
            </div>
          </div>
          <div class="eleven columns omega">
            <div class="field">
              <%= label_tag :q_number_cont, Spree.t(:printable_number, scope: 'print_invoice') %>
              <%= f.text_field :number_cont, class: 'form-control js-quick-search-target' %>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="five columns alpha">
            <div class="field">
              <%= label_tag :q_firstname_start, Spree.t(:first_name_begins_with) %>
              <%= f.text_field :firstname_start, class: 'form-control' %>
            </div>
          </div>
          <div class="five columns">
            <div class="field">
              <%= label_tag :q_lastname_start, Spree.t(:last_name_begins_with) %>
              <%= f.text_field :lastname_start, class: 'form-control' %>
            </div>
          </div>
          <div class="six columns omega">
            <div class="field">
              <%= label_tag :q_email_cont, Spree.t(:email) %>
              <%= f.text_field :email_cont, class: 'form-control js-filterable' %>
            </div>
          </div>
        </div>

        <div data-hook="admin_orders_index_search_buttons" class="filter-actions">
          <%= button Spree.t(:filter_results) %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= paginate @bookkeeping_documents, scope: main_app, theme: "solidus_admin" %>
<% end %>

<% if @bookkeeping_documents.any? %>
  <table id="listing_orders" data-hook>
    <thead>
      <tr data-hook="printables_index_headers">
        <th><%= sort_link @search, :created_at, t(:date, scope: [:spree, :print_invoice]) %></th>
        <th><%= t(:document_type, scope: [:spree, :print_invoice]) %></th>
        <th><%= sort_link @search, :number, t(:number, scope: [:spree, :print_invoice]) %></th>
        <th><%= sort_link @search, :firstname, t(:firstname, scope: [:spree, :print_invoice]) %></th>
        <th><%= sort_link @search, :lastname, t(:lastname, scope: [:spree, :print_invoice]) %></th>
        <th><%= sort_link @search, :email, t(:email, scope: [:spree, :print_invoice]) %></th>
        <th><%= sort_link @search, :total, t(:total, scope: [:spree, :print_invoice]) %></th>
        <th data-hook="admin_orders_index_header_actions" class="actions"></th>
      </tr>
    </thead>
    <tbody>
    <% @bookkeeping_documents.each do |bookkeeping_document| %>
      <tr data-hook="admin_printables_index_rows" class="<%= cycle('odd', 'even') %>">
        <td><%= l bookkeeping_document.created_at.to_date %></td>
        <td><%= t(bookkeeping_document.document_type, scope: [:spree, :print_invoice]) %></td>
        <td><%= bookkeeping_document.number %></td>
        <td><%= bookkeeping_document.firstname %></td>
        <td><%= bookkeeping_document.lastname %></td>
        <td><%= bookkeeping_document.email %></td>
        <td><%= bookkeeping_document.display_total.to_html %></td>
        <td class='actions' data-hook="admin_orders_index_row_actions">
          <%= link_to_with_icon "file", "", admin_bookkeeping_document_path(bookkeeping_document, format: :pdf), title: "show_bookkeeping_document_#{bookkeeping_document.id}", no_text: true %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-info no-objects-found">
    <%= Spree.t(:no_resource_found, resource: plural_resource_name(Spree::BookkeepingDocument)) %>
  </div>
<% end %>

<% unless order_focused? %>
  <%= paginate @bookkeeping_documents, scope: main_app, theme: "solidus_admin" %>
<% end %>
