<% if order_focused? %>
  <% admin_breadcrumb(link_to plural_resource_name(Spree::Order), spree.admin_orders_path) %>
  <% admin_breadcrumb(link_to "##{@order.number}", spree.edit_admin_order_path(@order)) %>

  <% content_for :tabs do %>
    <%= render "spree/admin/shared/order_submenu", current: :documents, checkout_steps: @order.checkout_steps %>
  <% end %>

  <% content_for :page_title do %>
    <%= t(:documents_for_order, scope: [:spree, :print_invoice], order_number: @order.number) %>
  <% end %>
<% else %>
  <% content_for :page_title do %>
    <%= t(@document_type, scope: [:spree, :print_invoice, :document_headlines]) %>
  <% end %>

  <% content_for :table_filter_title do %>
    <%= t(:search, scope: :spree) %>
  <% end %>

  <% content_for :table_filter do %>
    <div data-hook="admin_orders_index_search">
      <%= search_form_for [:admin, @search] do |f| %>
        <%= f.hidden_field :template_cont, value: params[:q][:template_cont] %>
        <div class="row">
          <div class="col-md-6">
            <div class="date-range-filter field">
              <%= f.label :created_at_gt,
                Spree::BookkeepingDocument.human_attribute_name(:created_at) %>
              <div class="date-range-fields input-group">
                <%= f.text_field :created_at_gt,
                  value: params[:q][:created_at_gt],
                  class: 'datepicker datepicker-from',
                  placeholder: t(:start, scope: :spree) %>
                <div class="input-group-prepend input-group-append">
                  <span class="input-group-text range-divider">
                    <i class="fa fa-arrow-right"></i>
                  </span>
                </div>
                <%= f.text_field :created_at_lt,
                  value: params[:q][:created_at_lt],
                  class: 'datepicker datepicker-to',
                  placeholder: t(:stop, scope: :spree) %>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="field">
              <%= label_tag :q_number_cont, t(:printable_number, scope: "spree.print_invoice") %>
              <%= f.text_field :number_cont, class: 'form-control js-quick-search-target' %>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-4">
            <div class="field">
              <%= label_tag :q_firstname_start, t(:first_name_begins_with, scope: :spree) %>
              <%= f.text_field :firstname_start, class: 'form-control' %>
            </div>
          </div>
          <div class="col-md-4">
            <div class="field">
              <%= label_tag :q_lastname_start, t(:last_name_begins_with, scope: :spree) %>
              <%= f.text_field :lastname_start, class: 'form-control' %>
            </div>
          </div>
          <div class="col-md-4">
            <div class="field">
              <%= label_tag :q_email_cont, t(:email, scope: :spree) %>
              <%= f.text_field :email_cont, class: 'form-control js-filterable' %>
            </div>
          </div>
        </div>

        <div data-hook="admin_orders_index_search_buttons" class="filter-actions">
          <%= button_tag t(:filter_results, scope: :spree) %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= paginate @bookkeeping_documents, scope: spree, theme: "solidus_admin" %>
<% end %>

<% if @bookkeeping_documents.any? %>
  <% if order_focused? %>
    <fieldset class="no-border-bottom">
      <legend align="center"><%= plural_resource_name(Spree::BookkeepingDocument) %></legend>
      <%= render "table" %>
    </fieldset>
  <% else %>
    <%= render "table" %>
  <% end %>
<% else %>
  <div class="alert alert-info text-center">
    <%= t(:no_resource_found, scope: :spree, resource: plural_resource_name(Spree::BookkeepingDocument)) %>
  </div>
<% end %>

<% unless order_focused? %>
  <%= paginate @bookkeeping_documents, scope: spree, theme: "solidus_admin" %>
<% end %>
