<table>
  <thead>
    <tr data-hook="printables_index_headers">
      <th><%= sort_link @search, :created_at %></th>
      <th><%= Spree::BookkeepingDocument.human_attribute_name(:document_type) %></th>
      <th><%= sort_link @search, :number %></th>
      <th><%= Spree::BookkeepingDocument.human_attribute_name(:order) %></th>
      <th><%= sort_link @search, :name %></th>
      <th><%= sort_link @search, :email %></th>
      <th><%= sort_link @search, :total %></th>
      <th data-hook="admin_orders_index_header_actions" class="actions"></th>
    </tr>
  </thead>
  <tbody data-hook="admin_printables_index_rows">
  <% @bookkeeping_documents.each do |bookkeeping_document| %>
    <tr class="<%= cycle('odd', 'even') %>">
      <td><%= l bookkeeping_document.created_at.to_date %></td>
      <td><%= t(bookkeeping_document.document_type, scope: [:spree, :print_invoice]) %></td>
      <td class="number"><%= bookkeeping_document.number %></td>
      <td class="number">
        <%=
          case bookkeeping_document.printable
          when Spree::Order
            link_to bookkeeping_document.printable.number, spree.edit_admin_order_path(bookkeeping_document.printable)
          when Spree::Shipment
            link_to bookkeeping_document.printable.number, spree.edit_admin_order_path(bookkeeping_document.printable.order)
          else
            bookkeeping_document.printable&.number
          end
        %>
      </td>
      <td><%= bookkeeping_document.name %></td>
      <td><%= bookkeeping_document.email %></td>
      <td class="number"><%= bookkeeping_document.display_total.to_html %></td>
      <td class='actions' data-hook="admin_orders_index_row_actions">
        <%= link_to_with_icon "refresh", "", admin_bookkeeping_document_path(bookkeeping_document), no_text: true, method: :delete, data: { confirm:t(".are_you_sure"), title: t(".refresh_file") } %>
        <%= link_to_with_icon "file", "", admin_bookkeeping_document_path(bookkeeping_document, format: :pdf), title: "show_bookkeeping_document_#{bookkeeping_document.id}", no_text: true %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
